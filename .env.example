# Database (use DB_* or DATABASE_*; either set works)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_DATABASE=
DB_SSL=true
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# Server
API_PORT=
JWT_SECRET=
SYNC_SECRET_KEY=
# Operational endpoints are disabled until their own secrets are configured.
METRICS_SECRET_KEY=
GITHUB_WEBHOOK_SECRET=
VERCEL_WEBHOOK_SECRET=
RAILWAY_WEBHOOK_SECRET=
ENFORCE_HTTPS=true
# Lista de origens separadas por virgula (ex.: painel/prod)
CORS_ORIGINS=
PDF_SERVICE_URL=http://localhost:8080

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional: JSON file path instead of the vars above
FIREBASE_SERVICE_ACCOUNT_PATH=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email delivery
# EMAIL_PROVIDER=brevo
# Brevo HTTP API example:
# BREVO_API_KEY=
# EMAIL_BRAND_NAME=EncontreAqui Imóveis
# EMAIL_FROM=no-reply@encontreaquiimoveis.com
# EMAIL_FROM_NAME=EncontreAqui Imoveis
# EMAIL_LOGO_URL_2X=https://cdn.exemplo.com/email/logo@2x.png
# EMAIL_VERIFICATION_SURFACE_URL=https://site-imobiliario-encontreaqui.vercel.app/verificacao
# PASSWORD_RESET_SURFACE_URL=https://site-imobiliario-encontreaqui.vercel.app/recuperar-senha
# Brevo SMTP fallback example:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
EMAIL_PROVIDER=
EMAIL_BRAND_NAME=
EMAIL_FROM=
EMAIL_FROM_NAME=
EMAIL_LOGO_URL_2X=
EMAIL_VERIFICATION_SURFACE_URL=
PASSWORD_RESET_SURFACE_URL=
EMAIL_HTTP_TIMEOUT_MS=
BREVO_API_KEY=
BREVO_API_BASE_URL=
BREVO_FROM=
BREVO_FROM_NAME=
RESEND_API_KEY=
RESEND_API_BASE_URL=
# SMTP fallback
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_CONNECTION_TIMEOUT_MS=
SMTP_GREETING_TIMEOUT_MS=
SMTP_SOCKET_TIMEOUT_MS=
SMTP_DNS_TIMEOUT_MS=
SMTP_FAMILY=
SMTP_REQUIRE_TLS=
SMTP_IGNORE_TLS=
SMTP_TLS_SERVERNAME=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SERVICE=
SMTP_DEBUG=
SMTP_TIMEOUT_MS=

# Public site handler used in email verification links
EMAIL_VERIFICATION_HANDLER_URL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=
R2_PREFIX=
# Dry-run is the default. Deleting orphan R2 objects additionally requires both
# the --delete-orphans argument and R2_RECONCILIATION_CONFIRM=DELETE_ORPHANS.
R2_RECONCILIATION_CONFIRM=
# Telemetria externa e opt-in. Mantenha desabilitado em producao ate haver
# contrato com o operador, politica de minimizacao e revisao de privacidade.
SENTRY_ENABLED=false
SENTRY_DSN=
# 0.01 e o limite recomendado quando Sentry for explicitamente habilitado.
SENTRY_TRACES_SAMPLE_RATE=0.01
# Retencao de notificacoes. O worker so remove registros quando habilitado
# explicitamente; logs da plataforma devem ser configurados no Railway/Vercel.
DATA_RETENTION_WORKER_ENABLED=false
NOTIFICATION_RETENTION_DAYS=180
DATA_RETENTION_BATCH_SIZE=250
# Prazo operacional para configurar no provedor de logs, nao e controlado pelo Node.
PLATFORM_LOG_RETENTION_DAYS=30
REGISTRATION_DRAFT_TTL_MINUTES=60
# Public flow limits: IP ceilings absorb volume; account/session/draft ceilings
# stop repeated attacks without penalizing a shared network.
AUTH_REGISTRATION_RATE_LIMIT_MAX=30
AUTH_REGISTRATION_ACCOUNT_RATE_LIMIT_MAX=4
OTP_VERIFY_RATE_LIMIT_MAX=60
OTP_VERIFY_SESSION_RATE_LIMIT_MAX=5
PREAUTH_UPLOAD_RATE_LIMIT_MAX=20
PREAUTH_UPLOAD_DRAFT_RATE_LIMIT_MAX=6
# Password hashing. Production accepts only values from 12 through 14; default is 12.
BCRYPT_ROUNDS=12

# Opt-in local TiDB concurrency suite. Never point these at TiDB Cloud/Railway.
# LOCAL_CONCURRENCY_TESTS=1
# LOCAL_CONCURRENCY_DB_HOST=127.0.0.1
# LOCAL_CONCURRENCY_DB_PORT=4000
# LOCAL_CONCURRENCY_DB_USER=root
# LOCAL_CONCURRENCY_DB_PASSWORD=
# LOCAL_CONCURRENCY_DB_DATABASE=imobiliaria_security_test
