{
  "name": "imobiliaria-backend",
  "version": "1.0.0",
  "description": "API para o aplicativo imobiliário",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc",
    "start": "node dist/database/deploy.js && node dist/server.js",
    "test": "node ./node_modules/vitest/vitest.mjs run --exclude tests/local-stress/** --pool=forks --maxWorkers=2 --no-file-parallelism --reporter=dot --silent",
    "test:unit": "node ./node_modules/vitest/vitest.mjs run src tests/services tests/utils tests/middlewares tests/config tests/controllers tests/modules --pool=forks --maxWorkers=2 --no-file-parallelism --reporter=dot --silent",
    "test:integration": "node ./node_modules/vitest/vitest.mjs run tests/routes tests/database tests/migrations --pool=forks --maxWorkers=2 --no-file-parallelism --reporter=dot --silent",
    "test:performance": "node ./node_modules/vitest/vitest.mjs run tests/performance --pool=forks --maxWorkers=1 --no-file-parallelism --reporter=dot --silent",
    "test:coverage": "node ./node_modules/vitest/vitest.mjs run --coverage --exclude tests/local-stress/** && node scripts/check-critical-coverage.cjs",
    "test:architecture": "node scripts/check-architecture-discipline.cjs",
    "test:watch": "node ./node_modules/vitest/vitest.mjs --exclude tests/local-stress/**",
    "test:local-stress:email-codes": "node ./node_modules/vitest/vitest.mjs run tests/local-stress/email-code-challenges.test.ts",
    "test:local-stress:r2-documents": "node ./node_modules/vitest/vitest.mjs run tests/local-stress/negotiation-r2-documents.test.ts",
    "test:local-concurrency": "node ./node_modules/vitest/vitest.mjs run tests/local-stress/contract-concurrency.mysql.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism --reporter=dot",
    "ci:verify": "npm run build && npm run test:architecture && npm run test",
    "security:audit": "npm audit --audit-level=high",
    "test:sast:r2-documents": "cross-env PYTHONUTF8=1 semgrep scan --config auto src/services/negotiationDocumentStorageService.ts src/modules/negotiations/infra/NegotiationDocumentsRepository.ts src/controllers/NegotiationController.ts src/controllers/ContractController.ts src/controllers/AdminController.ts",
    "migrate:up": "ts-node src/database/migrationRunner.ts up",
    "migrate:down": "ts-node src/database/migrationRunner.ts down",
    "migrate:status": "ts-node src/database/migrationRunner.ts status",
    "locations:seed": "ts-node src/scripts/seedLocationCatalog.ts",
    "db:init": "npm run db:bootstrap",
    "db:bootstrap": "npm run build && node dist/database/bootstrap.js",
    "db:deploy": "npm run build && node dist/database/deploy.js",
    "db:verify": "ts-node src/database/schemaVerification.ts",
    "admin:create-initial": "npm run build && node dist/scripts/createInitialAdmin.js",
    "audit:contract-deal-types": "ts-node scripts/audit-contract-deal-types.ts",
    "audit:contract-buyer-names": "ts-node scripts/audit-contract-buyer-legal-names.ts",
    "audit:contract-document-rejections": "ts-node scripts/backfill-contract-document-rejections.ts",
    "audit:r2-documents": "npm run build && node dist/scripts/reconcileNegotiationDocumentStorage.js",
    "admin:create-document-operator": "ts-node src/scripts/createPanelDocumentOperator.ts",
    "sentry:test": "ts-node scripts/sentry-test.ts"
  },
  "keywords": [],
  "author": "Ctrshift-Pm",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@sentry/node": "^10.69.0",
    "@sentry/profiling-node": "^10.69.0",
    "@types/nodemailer": "^7.0.12",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.2",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "multer": "^2.2.0",
    "mysql2": "^3.19.1",
    "nodemailer": "^9.0.3",
    "prom-client": "^15.1.3",
    "punycode": "^2.3.1"
  },
  "overrides": {
    "fast-xml-parser": "5.10.1",
    "fast-xml-builder": "1.3.0",
    "form-data": "4.0.6",
    "lodash": "4.18.1",
    "path-to-regexp": "8.4.2",
    "picomatch": "4.0.5",
    "@types/request": {
      "form-data": "4.0.6"
    }
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.19.37",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^7.0.3",
    "supertest": "^7.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^3.1.0"
  }
}
